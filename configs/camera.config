# Air-unit camera capture path: the NT99235 sensor subdev, and the V4L2
# subdev/media-controller framework its capture graph is built on.
#
# The media core, VIDEO_DEV and the videobuf2 backends are already turned on by
# codec.config (the air unit merges both), so this fragment only adds what the
# capture side needs on top. It must be merged AFTER trim.config, which disables
# MEDIA_SUPPORT wholesale.
#
# The sensor is a MODULE for the same reason the codec is: the air unit's kernel
# slot is 6 MiB and the Image is already close to it. It also keeps the sensor
# reloadable during bring-up, which matters because the unit's power-on window
# is short.
#
# The three drivers form one capture graph: sensor -> CSI-2 receiver -> VIF,
# with the VIF owning the media device and the video node.

CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_MEDIA_CONTROLLER=y
CONFIG_VIDEO_DEV=y
CONFIG_VIDEO_V4L2_SUBDEV_API=y
CONFIG_V4L2_FWNODE=y
CONFIG_V4L2_ASYNC=y
CONFIG_VIDEO_CAMERA_SENSOR=y
CONFIG_VIDEOBUF2_DMA_CONTIG=y
CONFIG_VIDEO_ARTOSYN_NT99235=m
CONFIG_VIDEO_ARTOSYN_CSI2=m
CONFIG_VIDEO_ARTOSYN_VIF=m
