# Post-mortem instrumentation for the hard freeze: the goggle stops answering ping with video
# live, prints nothing, and only the hardware watchdog recovers it. Everything here exists to
# leave evidence in DRAM that survives that reset.
#
# Opt-in, merged LAST via EXTRA_FRAGMENTS=debug-freeze. It grows the Image past the 6 MB
# kernel slot, so a kernel built with it is RAM-booted, never flashed.
#
#   BOARD=betafpv-vr04-goggle EXTRA_FRAGMENTS=debug-freeze scripts/build.sh
#
# The evidence lands in the ramoops@29100000 region declared by the board DTS. After the reset
# it reappears as /sys/fs/pstore; glue/dev/pstore-harvest.sh pulls it to the host.

# --- pstore/ramoops: the persistent store itself ------------------------------------------
# Built in, not a module: a module has to be loaded before it can record, and the freeze can
# arrive at any point after boot.
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
# Every printk goes to the persistent console ring as it is emitted, so the last lines before
# the SoC dies are already in DRAM. This is the primary record.
CONFIG_PSTORE_CONSOLE=y
# /dev/pmsg0: userspace writes breadcrumbs into the same persistent region. ml-pipeline marks
# its submit/flip phases here, which places the freeze within one frame's work.
CONFIG_PSTORE_PMSG=y
# A per-CPU ring of the last function calls, filtered at runtime to the DMA/codec/DRM paths.
CONFIG_PSTORE_FTRACE=y
# Records are kept uncompressed: a compressed record is unreadable if the dump was cut short
# mid-write, which is the case this fragment exists to capture.
# CONFIG_PSTORE_COMPRESS is not set

# --- function tracer: the source of the ftrace ring ---------------------------------------
# Call sites are NOPs until a filter is armed, so an idle tracer costs image size and nothing
# else. Armed narrowly (set_ftrace_filter) it records only the paths under suspicion.
CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_DYNAMIC_FTRACE=y
CONFIG_STACKTRACE=y

# --- lockup detection: turn a silent hang into a dumped panic ------------------------------
# GIC-400 is GICv2, so arm64 has no pseudo-NMI and no perf hardlockup detector. The buddy
# detector is the one that works here: each CPU checks that its buddy's timer interrupt count
# is still moving, so a core wedged with interrupts off is caught by the other core.
CONFIG_HARDLOCKUP_DETECTOR=y
CONFIG_HARDLOCKUP_DETECTOR_BUDDY=y
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_DETECT_HUNG_TASK=y
# Panic on detection: a panic runs the kmsg dumper into ramoops, where a plain warning would
# only reach a console nobody is reading when the unit is flying.
CONFIG_BOOTPARAM_HARDLOCKUP_PANIC=y
CONFIG_BOOTPARAM_SOFTLOCKUP_PANIC=y
CONFIG_PANIC_ON_OOPS=y
# Stay panicked rather than rebooting, so the hardware watchdog performs the reset on its own
# schedule and the state is still on the serial console if anyone is attached.
CONFIG_PANIC_TIMEOUT=0

# --- watchdog pretimeout: a dump one timeout before the reset ------------------------------
# The DesignWare block raises its interrupt on the first expiry and only resets on the second.
# watchdog@1600000 already supplies that interrupt, so a stopped feeder panics (and dumps)
# before the hardware takes the unit away.
CONFIG_WATCHDOG_PRETIMEOUT_GOV=y
CONFIG_WATCHDOG_PRETIMEOUT_GOV_PANIC=y
CONFIG_WATCHDOG_PRETIMEOUT_DEFAULT_GOV_PANIC=y

# --- making the dumps readable -------------------------------------------------------------
# 128 KB of printk ring, up from trim.config's 16 KB: the console ring is only as deep as the
# buffer feeding it, and the pipeline is talkative.
CONFIG_LOG_BUF_SHIFT=17
# Static functions resolve to names instead of raw addresses in a backtrace.
CONFIG_KALLSYMS_ALL=y
# sysrq over the serial console and /proc/sysrq-trigger: forces a dump on demand while the
# machine is still half alive, which is how a soft wedge gets characterised.
CONFIG_MAGIC_SYSRQ=y
CONFIG_MAGIC_SYSRQ_DEFAULT_ENABLE=0x1

# trim.config's -Os is kept. The freeze is timing-dependent and has only ever reproduced under
# the flight soak, so this fragment holds code generation as close to the shipping kernel as
# instrumentation allows; kallsyms carries the backtraces instead.
