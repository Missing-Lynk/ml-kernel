# Bind button on the air unit: one GPIO line (global 42, active low) decoded by the
# in-kernel gpio-keys-polled driver into evdev events on /dev/input/eventN.
#
# Polled, not interrupt-driven: artosyn_gpio (modules/) registers a get/set/direction
# gpiochip with no irqchip, so plain gpio-keys cannot bind - it requires an interrupt per
# button. See docs/artosyn-gpio.md and devices/betafpv-vr04-air/proxima-9311-air.dts.
#
# MERGE THIS AFTER trim.config so it overrides trim's input disables. Distinct from
# input.config, which is the goggle's IIO + adc-keys voltage ladder.

# Input core + evdev, both built in (the userspace consumer opens /dev/input/eventN).
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y

# Keyboard class + the polled GPIO key driver.
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_GPIO_POLLED=y

# The two drivers olddefconfig would otherwise turn on once INPUT_KEYBOARD is set, neither of
# which can work here: adc-keys is the goggle's voltage ladder (no ladder on this board), and
# interrupt-driven gpio-keys cannot bind to an irqchip-less gpiochip.
# CONFIG_KEYBOARD_ADC is not set
# CONFIG_KEYBOARD_GPIO is not set
