+		dst_buf->field = V4L2_FIELD_NONE;
+		v4l2_m2m_buf_done(dst_buf, VB2_BUF_STATE_ERROR);
+	}
+
+	v4l2_m2m_job_finish(inst->v4l2_m2m_dev, m2m_ctx);
+
+	mutex_unlock(&inst->dev->irq_lock);
