+int wave5_vpu_enc_update_rate(struct vpu_instance *inst, u32 enable)
+{
+	struct enc_info *p_enc_info = &inst->codec_info->enc_info;
+	struct vpu_device *vpu_dev = inst->dev;
+	int ret;
+
+	ret = mutex_lock_interruptible(&vpu_dev->hw_lock);
+	if (ret)
+		return ret;
+
+	p_enc_info->open_param.bit_rate = inst->bit_rate;
+	p_enc_info->open_param.frame_rate_info = inst->frame_rate;
+	/*
+	 * VBR pins the window at 3000 when the instance is opened; keep the live
+	 * path on that same rule so a mode change cannot be undone from here.
+	 */
+	if (inst->rc_mode != 0)
+		p_enc_info->open_param.vbv_buffer_size = inst->vbv_buf_size;
+
+	ret = wave5_vpu_enc_change_param(inst, enable);
+
+	mutex_unlock(&vpu_dev->hw_lock);
+
+	return ret;
+}
+
+int wave5_vpu_enc_apply_pending_rate(struct vpu_instance *inst)
+{
+	u32 pending = inst->enc_rate_change_pending;
+
+	if (!pending)
+		return 0;
+
+	/*
+	 * Consume the request even when the firmware rejects it. Retrying on
+	 * the next frame would queue a SET_PARAM per picture behind an encoder
+	 * that is already unhappy; one attempt per userspace request keeps the
+	 * failure bounded and visible in the log.
+	 */
+	inst->enc_rate_change_pending = 0;
+
+	return wave5_vpu_enc_update_rate(inst, pending);
+}
