+/*
+ * ML (Artosyn): /sys/kernel/debug/wave5.
+ *
+ * state reports the four registers that separate a healthy VPU from a poisoned one - a VCPU
+ * program counter frozen at one address with BUSY_STATUS still set is the wedge signature - plus
+ * the live instances and their fault counters. recover accepts 1 and performs the global block
+ * reset and firmware re-download. It destroys every live instance, so it is an operator tool for
+ * a VPU that has already stopped answering, not something to wire into a running pipeline.
+ */
+static int wave5_debugfs_state_show(struct seq_file *m, void *unused)
+{
+	struct vpu_device *dev = m->private;
+	struct vpu_instance *inst;
+	unsigned long flags;
+	int ret;
+
+	ret = pm_runtime_resume_and_get(dev->dev);
+	if (ret)
+		return ret;
+
+	seq_printf(m, "product_code   0x%08x\n", dev->product_code);
+	seq_printf(m, "vcpu_cur_pc    0x%08x\n", vpu_read_reg(dev, W5_VCPU_CUR_PC));
+	seq_printf(m, "busy_status    0x%08x\n", vpu_read_reg(dev, W5_VPU_BUSY_STATUS));
+	seq_printf(m, "vint_reason    0x%08x\n", vpu_read_reg(dev, W5_VPU_VINT_REASON));
+	seq_printf(m, "fail_reason    0x%08x\n", vpu_read_reg(dev, W5_RET_FAIL_REASON));
+	seq_printf(m, "firmware       %s\n", dev->fw_name ? dev->fw_name : "(none)");
+
+	pm_runtime_put_sync(dev->dev);
+
+	spin_lock_irqsave(&dev->irq_spinlock, flags);
+	list_for_each_entry(inst, &dev->instances, list)
+		seq_printf(m, "inst %d %s state %d job_timeouts %u fw_faults %u\n",
+			   inst->id, inst->type == VPU_INST_TYPE_ENC ? "enc" : "dec",
+			   inst->state, inst->job_timeout_count, inst->enc_fault_count);
+	spin_unlock_irqrestore(&dev->irq_spinlock, flags);
+
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(wave5_debugfs_state);
