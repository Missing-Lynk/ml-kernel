+static ssize_t wave5_debugfs_recover_write(struct file *file, const char __user *buf,
+					   size_t count, loff_t *ppos)
+{
+	struct vpu_device *dev = file_inode(file)->i_private;
+	bool go;
+	int ret;
+
+	ret = kstrtobool_from_user(buf, count, &go);
+	if (ret)
+		return ret;
+	if (!go)
+		return count;
+
+	ret = pm_runtime_resume_and_get(dev->dev);
+	if (ret)
+		return ret;
+
+	ret = wave5_vpu_recover(dev);
+
+	pm_runtime_put_sync(dev->dev);
+
+	return ret ? ret : count;
+}
+
+static const struct file_operations wave5_debugfs_recover_fops = {
