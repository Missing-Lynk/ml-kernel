Why: two changes to the instance-teardown path.

Upstream takes interruptible locks in teardown and bails out early on close
failure. Teardown runs from file release, where on SIGKILL a fatal signal is
already pending, so the interruptible lock returns -EINTR immediately and the
instance's buffers (FBC framebuffers, bitstream ring, work/task) leak from the
fixed mmz pool until power cycle; the early returns leak the same way since the
fd is gone regardless. Locks made uninterruptible and every path made to reach
cleanup.

wave5_cleanup_instance then unconditionally freed the FBC/DPB framebuffers and
the bitstream ring, which defeats the deliberate leak in 0240: freeing memory a
running firmware instance still DMAs into hard-hangs the SoC. Cleanup now
honours keep_dma_bufs (0250) and leaks those buffers too.
--- a/drivers/media/platform/chips-media/wave5/wave5-helper.c
+++ b/drivers/media/platform/chips-media/wave5/wave5-helper.c
@@ -45,10 +45,19 @@
 	    inst->dev->product_code != WAVE515_CODE)
 		wave5_vdi_free_sram(inst->dev);
 
-	for (i = 0; i < inst->fbc_buf_count; i++)
-		wave5_vpu_dec_reset_framebuffer(inst, i);
+	/* ML (Artosyn): when close left the firmware instance running (keep_dma_bufs),
+	 * the framebuffers and bitstream ring are still firmware DMA targets; freeing
+	 * them lets the firmware write reallocated memory and hard-hangs the SoC.
+	 * Leak them, matching the work/task buffers the close path already leaked. */
+	if (inst->keep_dma_bufs) {
+		dev_warn(inst->dev->dev,
+			 "instance not quiesced, leaking framebuffers and bitstream ring\n");
+	} else {
+		for (i = 0; i < inst->fbc_buf_count; i++)
+			wave5_vpu_dec_reset_framebuffer(inst, i);
 
-	wave5_vdi_free_dma_memory(inst->dev, &inst->bitstream_vbuf);
+		wave5_vdi_free_dma_memory(inst->dev, &inst->bitstream_vbuf);
+	}
 	v4l2_ctrl_handler_free(&inst->v4l2_ctrl_hdl);
 	if (inst->v4l2_fh.vdev) {
 		v4l2_fh_del(&inst->v4l2_fh, filp);
@@ -82,9 +91,14 @@
 	 * in the wave5_vpu_dec_finish_decode.
 	 * So the spin lock and mutex were used to protect the list in the release function.
 	 */
-	ret = mutex_lock_interruptible(&inst->dev->irq_lock);
-	if (ret)
-		return ret;
+	/* ML (Artosyn): must NOT be interruptible, and every path below must reach
+	 * wave5_cleanup_instance. This runs from the file-release path; on SIGKILL the
+	 * fatal signal is already pending, so an interruptible lock returns -EINTR
+	 * immediately and the whole instance (FBC framebuffers, bitstream ring, work/task
+	 * buffers) leaks from the fixed mmz pool until power cycle. Same for the early
+	 * returns on close failure: the fd is gone either way, so bailing out only
+	 * converts a firmware hiccup into a permanent pool leak. */
+	mutex_lock(&inst->dev->irq_lock);
 	spin_lock_irqsave(&inst->dev->irq_spinlock, flags);
 	list_del_init(&inst->list);
 	spin_unlock_irqrestore(&inst->dev->irq_spinlock, flags);
@@ -96,17 +110,15 @@
 		if (fail_res == WAVE5_SYSERR_VPU_STILL_RUNNING) {
 			dev_err(inst->dev->dev, "%s close failed, device is still running\n",
 				name);
-			return -EBUSY;
-		}
-		if (ret && ret != -EIO) {
+			ret = -EBUSY;
+		} else if (ret && ret != -EIO) {
 			dev_err(inst->dev->dev, "%s close, fail: %d\n", name, ret);
-			return ret;
 		}
 	}
 
 	wave5_cleanup_instance(inst, filp);
 
-	return ret;
+	return ret == -EIO ? 0 : ret;
 }
 
